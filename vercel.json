{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/automations/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/flows/cron",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 60
    }
  }
}
