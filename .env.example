# ============================================================
# KYRON - CRM — VERCEL ENVIRONMENT VARIABLES (.env.example)
# ============================================================

# ------------------------------------------------------------
# 1. SUPABASE (Banco de Dados / Autenticação Serverless)
# Configure em: Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------
# 2. SEGURANÇA E CRIPTOGRAFIA
# ------------------------------------------------------------
# Criptografia AES-256 (64 caracteres hexadecimais = 32 bytes).
# Gerar via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Segredo para autenticar requisições de Cron Jobs Serverless (Vercel Cron)
CRON_SECRET=your-cron-secret-key
AUTOMATION_CRON_SECRET=your-cron-secret-key

# ------------------------------------------------------------
# 3. INTEGRACÃO WHATSAPP (Evolution API / Meta Cloud API)
# ------------------------------------------------------------
# URL e API Key da Evolution API externa (ex: VPS na porta 8080 ou subdomínio HTTPS)
EVOLUTION_API_URL=http://129.121.45.5:8080
EVOLUTION_API_KEY=your_evolution_api_key_here

# Meta Cloud API (Oficial — Opcional)
META_APP_SECRET=your-meta-app-secret
META_APP_ID=your-meta-app-id

# ------------------------------------------------------------
# 4. CONFIGURAÇÕES DA APLICAÇÃO VERCEL
# ------------------------------------------------------------
# URL pública de produção da Vercel (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# Idioma da Interface (pt = Português do Brasil)
NEXT_PUBLIC_APP_LOCALE=pt
